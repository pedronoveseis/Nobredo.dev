# Copie para .env (não versionado) e carregue antes de rodar: set -a; source .env; set +a

# Obrigatórias
LINK_TOKEN=               # mínimo 16 chars [A-Za-z0-9_-]. Gere com: openssl rand -hex 16
ADMIN_PASSWORD_HASH=      # gere com: ./gradlew -q run --args="hash-password"  (ou o binário instalado)

# Opcionais
ADMIN_USER=admin
PORT=8080
DB_PATH=data/nobredo.db
TARGET_AT=2026-11-22T16:00:00-03:00
